From 4e7e5e8b5c1049d9c5962472c218134e30c96809 Mon Sep 17 00:00:00 2001
From: QSL Fix Bundle <fix@qsl.local>
Date: Mon, 7 Sep 2026 08:21:27 +0000
Subject: [PATCH] fix(quotations): pin QR to bottom of page 1 only (above
 footer)

Move the verify QR back to the bottom of the quotation, fixed above the
footer, and render it only on page 1. Long line-items and terms flow onto
following pages without the QR; the QR does not repeat on later pages.
---
 src/pdf/QuotationDocument.jsx | 29 ++++++++++++++++++-----------
 1 file changed, 18 insertions(+), 11 deletions(-)

diff --git a/src/pdf/QuotationDocument.jsx b/src/pdf/QuotationDocument.jsx
index fea3da7..c0e8a10 100644
--- a/src/pdf/QuotationDocument.jsx
+++ b/src/pdf/QuotationDocument.jsx
@@ -90,7 +90,7 @@ function PayTable({ pairs }) {
 }
 
 const s = StyleSheet.create({
-  page: { paddingTop: 26, paddingBottom: 44, paddingHorizontal: 32, fontSize: 9, color: INK, fontFamily: "Helvetica" },
+  page: { paddingTop: 26, paddingBottom: 120, paddingHorizontal: 32, fontSize: 9, color: INK, fontFamily: "Helvetica" },
   topRow: { flexDirection: "row", justifyContent: "space-between", alignItems: "flex-start" },
   brandRow: { flexDirection: "row", alignItems: "flex-start", flex: 1, paddingRight: 14 },
   logo: { width: 62, height: 62, marginRight: 12, objectFit: "contain" },
@@ -173,7 +173,8 @@ const s = StyleSheet.create({
   payValCell: { paddingVertical: 6, paddingHorizontal: 5, borderRightWidth: 0.5, borderRightColor: "#EAE3D5", justifyContent: "center" },
   payValText: { fontSize: 8.2, fontFamily: "Helvetica-Bold", color: INK, textAlign: "center" },
   termsFull: { marginTop: 10, padding: 8, borderWidth: 0.5, borderColor: "#D9D2C4", borderRadius: 3, backgroundColor: "#FBF8F1" },
-  qrBlock: { flexDirection: "row", alignItems: "center", marginTop: 10, marginBottom: 4 },
+  // Fixed at the bottom of page 1 only (above the footer). Does not appear on later pages.
+  qrBlock: { position: "absolute", bottom: 42, left: 32, right: 32, flexDirection: "row", alignItems: "center" },
   qrImg: { width: 68, height: 68, marginRight: 10 },
   qrText: { flex: 1 },
   qrTitle: { fontSize: 8.5, fontFamily: "Helvetica-Bold", color: INK, textTransform: "uppercase", letterSpacing: 0.4 },
@@ -266,15 +267,6 @@ export function QuotationDocument({ quotation, logoSrc, qrSrc, internal = false
           </View>
         ) : null}
 
-        {/* Verify QR — kept on the first page (placed early) so long line-items /
-            terms flow onto following pages without carrying the QR with them. */}
-        {qrSrc ? (
-          <View style={s.qrBlock} wrap={false}>
-            {/* eslint-disable-next-line jsx-a11y/alt-text */}
-            <Image src={qrSrc} style={s.qrImg} />
-          </View>
-        ) : null}
-
         {/* Line-items table */}
         <View style={s.itemsTable}>
           <View style={s.itemsHead}>
@@ -387,6 +379,21 @@ export function QuotationDocument({ quotation, logoSrc, qrSrc, internal = false
 
         
 
+        {/* Verify QR — fixed at bottom of page 1 only (above footer). Long content
+            flows to later pages; the QR does not repeat or move with it. */}
+        {qrSrc ? (
+          <View
+            style={s.qrBlock}
+            fixed
+            render={({ pageNumber }) =>
+              pageNumber === 1 ? (
+                // eslint-disable-next-line jsx-a11y/alt-text
+                <Image src={qrSrc} style={s.qrImg} />
+              ) : null
+            }
+          />
+        ) : null}
+
         <View style={s.footer} fixed>
           <Text style={s.footText} render={({ pageNumber, totalPages }) => `${COMPANY.name} · ${q.number} · Page ${pageNumber} of ${totalPages}`} />
         </View>
-- 
2.43.0

